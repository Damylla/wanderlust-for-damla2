    "Wanderlust can continue without location access. You can enable it later in iPhone Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust kann auch ohne Standortzugriff verwendet werden.\nDu kannst ihn später in den iPhone-Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust can continue without location access.\nYou can enable it later in iPhone Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を許可しなくてもWanderlustを利用できます。\n後からiPhoneの設定で有効にできます。"
          }
        }
      }
    },
    "Wanderlust can continue without notifications. You can enable them later in iPhone Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust kann auch ohne Mitteilungen verwendet werden.\nDu kannst sie später in den iPhone-Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust can continue without notifications.\nYou can enable them later in iPhone Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を許可しなくてもWanderlustを利用できます。\n後からiPhoneの設定で有効にできます。"
          }
        }
      }
    },
    "Wanderlust can remind you to keep your trips and travel records up to date. You can use Wanderlust without notifications and change this later in iPhone Settings.": {
      "comment": "A description of the benefits of enabling notifications.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust kann dich ans Erfassen deiner Reisen erinnern.\nDie App funktioniert auch ohne Mitteilungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust can remind you to record your trips.\nYou can use the app without notifications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行の記録を忘れないよう通知できます。\n許可しなくても利用できます。"
          }
        }
      }
    },
    "Wanderlust uses the iPhone app language setting. Change the app language in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die App-Sprache in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the app language in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語は設定アプリから変更できます。"
          }
        }
      }
    },
    "Wanderlust uses your location to show your current position.\nYou can use Wanderlust without location access.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust verwendet deinen Standort, um deine aktuelle Position anzuzeigen.\nDu kannst Wanderlust auch ohne Standortzugriff nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanderlust uses your location to show your current position.\nYou can use Wanderlust without location access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の表示に位置情報を使います。\n許可しなくても利用できます。"
          }
        }
      }
    },
    "Watch your personal map fill up as you explore new countries. Every visited country lights up in color.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh zu, wie sich deine persönliche Karte mit jedem neuen Land füllt.\nJedes besuchte Land wird farbig hervorgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch your personal map fill up as you explore new countries.\nEvery visited country lights up in color."
          }
