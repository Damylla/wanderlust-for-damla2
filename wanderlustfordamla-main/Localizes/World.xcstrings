      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Städtesuche ist verfügbar, wenn diese Reise ein einziges Zielland hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City search is available when this trip has one destination country."
          }
        },
        "ja": {
