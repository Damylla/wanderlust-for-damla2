  "strings": {
    "Add a trip to start collecting stamps from the countries you visit.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Reise hinzu und sammle Stempel aus den Ländern, die du besucht hast."
